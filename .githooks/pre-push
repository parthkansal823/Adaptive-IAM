#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
if [ -x "$root/.venv/Scripts/python.exe" ]; then
  exec "$root/.venv/Scripts/python.exe" "$root/scripts/verify.py" --changed
elif [ -x "$root/.venv/bin/python" ]; then
  exec "$root/.venv/bin/python" "$root/scripts/verify.py" --changed
elif command -v python3 >/dev/null 2>&1; then
  exec python3 "$root/scripts/verify.py" --changed
else
  exec python "$root/scripts/verify.py" --changed
fi

