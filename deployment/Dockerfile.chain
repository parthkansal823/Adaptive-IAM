FROM node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app/blockchain
COPY blockchain/package.json blockchain/package-lock.json ./
RUN npm ci --omit=dev \
    && groupadd --gid 10001 iam \
    && useradd --uid 10001 --gid 10001 --no-create-home iam \
    && mkdir -p /var/lib/chain /var/lib/iam /app/blockchain/artifacts \
    && chown -R 10001:10001 /var/lib/chain /var/lib/iam /app/blockchain/artifacts
COPY --chown=10001:10001 blockchain/contracts contracts
COPY --chown=10001:10001 blockchain/scripts scripts
RUN node scripts/compile.mjs
USER 10001:10001
CMD ["node", "scripts/start-chain.mjs"]
