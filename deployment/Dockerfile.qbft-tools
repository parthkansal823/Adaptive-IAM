FROM node:24-bookworm-slim
WORKDIR /app/blockchain
COPY blockchain/qbft/package.json blockchain/qbft/package-lock.json ./
RUN npm ci --omit=dev && groupadd --gid 10001 iam && useradd --uid 10001 --gid 10001 --no-create-home iam \
    && mkdir -p /network /validator1 /validator2 /validator3 /validator4 /signer /auth /test-state \
    && chown -R 10001:10001 /network /validator1 /validator2 /validator3 /validator4 /signer /auth /test-state /app/blockchain
COPY --chown=10001:10001 blockchain/contracts contracts
COPY --chown=10001:10001 blockchain/scripts scripts
RUN node --input-type=module -e "import {compile} from './scripts/compile.mjs'; compile('london');"
USER 10001:10001
CMD ["node", "scripts/qbft-init.mjs"]
