FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY integrations/node/package.json integrations/node/package-lock.json integrations/node/
RUN npm --prefix integrations/node ci --omit=dev \
    && groupadd --gid 10001 site \
    && useradd --uid 10001 --gid 10001 --no-create-home site \
    && mkdir -p /var/lib/site && chown 10001:10001 /var/lib/site
COPY integrations/node/adaptive-iam.mjs integrations/node/
COPY integrations/examples/node-site.mjs integrations/examples/docker-transport.mjs integrations/examples/orbit-views.mjs integrations/examples/orbit.css integrations/examples/orbit.js integrations/examples/
COPY deployment/configure-site.mjs deployment/
USER 10001:10001
CMD ["node", "integrations/examples/node-site.mjs"]
